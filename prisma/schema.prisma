// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Values deliberately match src/lib/era.ts's ERA_VALUES display strings exactly (unlike
// CollectionReason's ALL_CAPS-plus-label-map pattern) since there's no separate label to carry.
enum Era {
  Modern
  Vintage
  Antique
}

enum CollectionReason {
  ARTISTRY
  CRAFT
  LORE
  HISTORY
  RARITY
  ACQUISITION
  COMPLETION
  VOLUME
  PERSONAL
}

model Series {
  id               String   @id @default(cuid())
  name             String   @unique @db.VarChar(200)
  slug             String   @unique @db.VarChar(240)
  subtitle         String?  @db.VarChar(300)
  description      String?
  heroImageUrl     String?
  attributionLabel String?  @db.VarChar(80)
  attributionText  String?  @db.VarChar(300)
  decks            Deck[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Creator {
  id            String         @id @default(cuid())
  name          String         @unique @db.VarChar(200)
  displayName   String?        @db.VarChar(240)
  slug          String         @unique @db.VarChar(240)
  tagline       String?        @db.VarChar(300)
  description   String?
  heroImageUrl  String?
  favorite      Boolean        @default(false)
  decksDesigned DeckDesigner[]
  decksProduced Deck[]         @relation("DeckProducer")
  coinsDesigned Coin[]         @relation("CoinDesigner")
  coinsProduced Coin[]         @relation("CoinProducer")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Deck {
  slug                      String?           @unique @db.VarChar(240)
  slugHistory               DeckSlugHistory[]
  id                        String            @id @default(cuid())
  name                      String
  seriesLegacy              String?           @map("series")
  seriesRaw                 String?
  seriesId                  String?
  series                    Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesOrder               Int?
  variantNote               String?           @db.VarChar(300)
  designerLegacy            String?           @map("designer")
  designers                 DeckDesigner[]
  producer                  String?
  producerCreatorId         String?
  producerCreator           Creator?          @relation("DeckProducer", fields: [producerCreatorId], references: [id], onDelete: Restrict)
  // Legacy free-text tag array, kept only as a historical compatibility mirror of the original
  // imported column. No longer written to by the app: Gilded/Signed/Mini/Tarot/Prototype/Edge
  // Painted live in the normalized `tags` relation below, and Modern/Vintage/Antique are now a
  // code-level calculated field (src/lib/era.ts's computeEra) backed by `manualEra` as the
  // fallback for decks with no releaseYear.
  tagsLegacy                String[]          @default([]) @map("tags")
  tags                      DeckTag[]
  // Fallback era classification, used only when releaseYear is null — computeEra() always
  // derives era from releaseYear's age when one is known, and this field is nulled out on save
  // whenever a releaseYear is present (see toDeckData in decks/actions.ts).
  manualEra                 Era?
  ownershipStatus           String            @default("Owned")
  qty                       Int               @default(1)
  productionRun             Int?
  releaseYear               Int?
  releaseYearEstimated      Boolean           @default(false)
  collectionReasonPrimary   CollectionReason?
  collectionReasonSecondary CollectionReason?
  hook                      String?           @db.VarChar(240)
  notes                     String?
  essay                     String?
  notesReviewedAt           DateTime?
  catalogNumber             String?
  favorite                  Boolean           @default(false)
  whiteWhale                Boolean           @default(false)
  images                    DeckImage[]
  editions                  DeckEdition[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([tagsLegacy], type: Gin, map: "Deck_tags_idx")
  @@index([designerLegacy], map: "Deck_designer_idx")
  @@index([producer])
  @@index([producerCreatorId])
  @@index([collectionReasonPrimary])
  @@index([collectionReasonSecondary])
  @@index([seriesLegacy], map: "Deck_series_idx")
  @@index([seriesId, seriesOrder])
}

model DeckDesigner {
  deckId     String
  designerId String
  sortOrder  Int     @default(0)
  deck       Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
  designer   Creator @relation(fields: [designerId], references: [id], onDelete: Restrict)

  @@id([deckId, designerId])
  @@unique([deckId, sortOrder])
  @@index([designerId])
}

// Normalized, extensible deck tags. New tags are added by inserting a row here — no migration or
// code change needed for the tag itself, just the resulting checkbox showing up in the deck form.
// Era (Modern/Vintage/Antique) deliberately does not live here; see Deck.manualEra and
// src/lib/era.ts's computeEra.
model Tag {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(60)
  decks     DeckTag[]
  createdAt DateTime  @default(now())
}

model DeckTag {
  deckId String
  tagId  String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([deckId, tagId])
  @@index([tagId])
}

model DeckImage {
  id        String   @id @default(cuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([deckId])
}

model DeckEdition {
  id         String   @id @default(cuid())
  deckId     String
  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckNumber Int
  createdAt  DateTime @default(now())

  @@index([deckId])
}

model Coin {
  id                String   @id @default(cuid())
  name              String
  series            String?
  designer          String?
  designerCreatorId String?
  designerCreator   Creator? @relation("CoinDesigner", fields: [designerCreatorId], references: [id], onDelete: Restrict)
  producer          String?
  producerCreatorId String?
  producerCreator   Creator? @relation("CoinProducer", fields: [producerCreatorId], references: [id], onDelete: Restrict)
  material          String?
  diameter          String?
  obverseImageUrl   String?
  reverseImageUrl   String?
  ownershipStatus   String   @default("Owned")
  qty               Int      @default(1)
  releaseYear       Int?
  notes             String?
  catalogNumber     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([designer])
  @@index([designerCreatorId])
  @@index([producer])
  @@index([producerCreatorId])
  @@index([series])
}

// Includes current and former addresses, so no other Deck can claim a historical slug.
model DeckSlugHistory {
  slug      String   @id @db.VarChar(240)
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([deckId])
}
